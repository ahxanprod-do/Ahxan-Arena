# PAYZAPI_API_KEY: Required for live PayZapi UPI & USDT Payment Gateway calls.
# Configure this in the Secrets panel in AI Studio.
PAYZAPI_API_KEY=MY_PAYZAPI_API_KEY

# RESEND_API_KEY: Optional API key from resend.com for sending 6-digit registration OTP emails.
# Configure this in the Secrets panel in AI Studio or inside Admin Gateway Settings.
RESEND_API_KEY=MY_RESEND_API_KEY

